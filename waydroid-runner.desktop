[Desktop Entry]
Type=Application
X-Nemo-Application-Type=no-invoker
Icon=waydroid-runner
Exec=waydroid-runner
Name=Waydroid
# The launcher calls the running instance, or starts one hidden through
# D-Bus activation, and shows its window
X-Maemo-Service=org.sailfishosopen.WaydroidRunner
X-Maemo-Object-Path=/org/sailfishosopen/WaydroidRunner
X-Maemo-Method=org.sailfishosopen.WaydroidRunner.activateWindow

[X-Sailjail]
Sandboxing=Disabled

# translation example:
# your app name in German locale (de)
#
# Remember to comment out the following line, if you do not want to use
# a different app name in German locale (de).
#Name[de]=Flatpak
